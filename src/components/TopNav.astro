---
// 모든 페이지 맨 위의 큰 메뉴. 왼쪽 열은 각 페이지 안의 목록만 맡는다(화면 사이 이동: 위쪽 메뉴)
interface Props { current: 'patterns' | 'plan' | 'components' | 'systems' }
const { current } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const items = [
  { id: 'patterns', label: '패턴', href: BASE },
  { id: 'plan', label: '내 서비스에 맞추기', href: `${BASE}plan/` },
  { id: 'components', label: '컴포넌트 사전', href: `${BASE}components/` },
  { id: 'systems', label: '디자인 시스템', href: `${BASE}systems/` },
];
---
<header class="topnav">
  <a class="brand" href={BASE}>UI 패턴 카탈로그</a>
  <nav aria-label="큰 메뉴">
    {items.map(it => <a href={it.href} aria-current={it.id === current ? 'page' : undefined}>{it.label}</a>)}
    {import.meta.env.DEV && <a href="/refs/" title="개발 서버에서만 보인다. 빌드에는 들어가지 않는다">실제 화면 <small>개인용</small></a>}
  </nav>
</header>
