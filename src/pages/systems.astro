---
// 디자인 시스템: 국내외 14곳의 특징·이용 조건·AI 연결, 패턴별로 어디가 말했는지, 숫자 기준. 시스템들이 하는 말 자체는 패턴 페이지 카드에 있다. 데이터는 data/systems.json
import '../styles/catalog.css';
import TopNav from '../components/TopNav.astro';
import systemsData from '../../data/systems.json';
import elementsData from '../../data/elements.json';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const SYS = Object.fromEntries(systemsData.systems.map(s => [s.id, s]));
const REGIONS = ['국내', '해외'];
type Guide = { refs: Record<string, string | null> };
const GUIDE = systemsData.guidance as Record<string, Guide[]>;
// 패턴 × 시스템: 그 시스템이 그 패턴에 대해 말한 기준 수
const covered = elementsData.elements.filter(e => GUIDE[e.id]?.length);
const countOf = (el: string, sys: string) => (GUIDE[el] || []).filter(g => sys in g.refs).length;
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>디자인 시스템 · UI 패턴 카탈로그</title>
<meta name="description" content="국내외 디자인 시스템 14곳의 특징·이용 조건·AI 연결과, 패턴별로 어느 시스템이 기준을 두었는지, 숫자 기준을 모았습니다.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap">
</head>
<body>
<TopNav current="systems" />
<aside class="side">
  <nav aria-label="디자인 시스템 목차">
    <b>시스템</b>
    {REGIONS.map(r => <a href={`#region-${r}`}><span>{r}</span><small>{systemsData.systems.filter(s => s.region === r).length}</small></a>)}
    <b>기준</b>
    <a href="#matrix"><span>패턴마다 참고할 시스템</span><small>{covered.length}</small></a>
    <a href="#numbers"><span>숫자 기준</span><small>{systemsData.numbers.length}</small></a>
  </nav>
</aside>
<main class="dict">
  <header class="el-head"><h1 class="dict-title">디자인 시스템 <small class="en">Design systems</small></h1><span class="sub">{systemsData.systems.length}곳 · 2026-10-29 확인</span></header>
  <p class="q">회사들이 공개한 디자인 시스템 문서를 읽고, 우리 패턴에 대해 하는 말을 우리 말로 요약했습니다. 글과 화면은 옮기지 않고 원문 링크를 겁니다.</p>

  {REGIONS.map(r => (
    <section class="dict-menu" id={`region-${r}`}>
      <h2 class="dict-menu-title">{r}</h2>
      <div class="dict-grid">
        {systemsData.systems.filter(s => s.region === r).map(s => (
          <article class="dcard sub sys" id={`sys-${s.id}`}>
            <div class="dslot">
              <h4>{s.name} <small class="en">{s.maker}</small></h4>
              <p class="one">{s.focus}</p>
            </div>
            <div class="dslot">
              <p class="kv"><span class="fl">이럴 때 참고</span><span>{s.refFor}</span></p>
              <p class="kv"><span class="fl">이용 조건</span><span>{s.license}</span></p>
              {s.ai.length > 0 && <p class="kv"><span class="fl">AI 연결</span><span>{s.ai.join(' · ')}</span></p>}
            </div>
            <div class="dslot end"><a class="giting" href={s.url} target="_blank" rel="noopener">문서 보기 ↗</a></div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="dict-menu" id="matrix">
    <h2 class="dict-menu-title">패턴마다 참고할 시스템</h2>
    <p class="q">점이 있으면 그 시스템 문서에 이 패턴에 대한 기준이 있습니다. 패턴 이름을 누르면 그 기준을 방식 카드와 함께 볼 수 있습니다.</p>
    <div class="matrix-wrap">
      <table class="matrix">
        <thead><tr><th scope="col">패턴</th>{systemsData.systems.map(s => <th scope="col"><a href={`#sys-${s.id}`}>{s.short}</a></th>)}</tr></thead>
        <tbody>
          {covered.map(e => (
            <tr><th scope="row"><a href={`${BASE}elements/${e.id}/`}>{e.name}</a></th>{systemsData.systems.map(s => { const n = countOf(e.id, s.id); return <td class={n ? 'on' : ''} title={n ? `${s.short}: 기준 ${n}줄` : undefined}>{n ? <span class="dot" aria-label="있음">●</span> : ''}</td>; })}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="dict-menu" id="numbers">
    <h2 class="dict-menu-title">숫자 기준</h2>
    <ul class="sys-rules">
      {systemsData.numbers.map(n => (
        <li><span><b>{n.k}</b> {n.v}</span><span class="by">{n.by.map(id => SYS[id].short).join(' · ')}</span></li>
      ))}
    </ul>
  </section>

  <footer class="dict-foot">
    각 시스템의 이름과 문서의 권리는 만든 회사에 있습니다. 이 페이지는 공개 문서를 읽고 우리 말로 요약한 것이며, 자세한 기준은 원문을 확인하세요. 조사 원본은 저장소의 research/design-systems/에 있습니다.
  </footer>
</main>
</body>
</html>
